<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Area administrativa (admin.html). Se usuario ou senha ficarem vazios, o admin fica desativado.
         Em producao, sobrescreva estes valores nas "Application settings" do host em vez de deixa-los aqui. -->
    <add key="AdminUsuario" value="Charlotte" />
    <add key="AdminSenha" value="Zeus" />

    <!-- Rifa -->
    <add key="TotalNumeros" value="200" />
    <add key="ValorNumero" value="20" />
    <add key="NomeRifa" value="Rifa" />

    <!-- Dados de pagamento exibidos ao usuario -->
    <add key="Favorecido" value="PREENCHER NOME DO FAVORECIDO" />
    <add key="ChavePix" value="PREENCHER CHAVE PIX" />
    <add key="InstrucoesPagamento" value="Pague via PIX e anexe o comprovante na proxima etapa." />

    <!-- E-mail que recebe comprovante + numeros -->
    <add key="EmailDestino" value="joaojeronimo21@hotmail.com" />

    <!-- SMTP de ENVIO (preencher). O Hotmail/Outlook NAO serve para enviar (a Microsoft desativou
         login por senha no SMTP); ele continua sendo apenas o DESTINATARIO acima.
         Gmail: smtp.gmail.com, porta 587, SSL=true, usuario = seu Gmail, senha = "senha de app"
                (exige verificacao em duas etapas). Limite gratuito ~500 e-mails/dia.
         Brevo: smtp-relay.brevo.com, porta 587, SSL=true, usuario/senha = chave SMTP do painel Brevo
                (plano gratis ~300 e-mails/dia; o remetente precisa ser verificado). -->
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpSsl" value="true" />
    <add key="SmtpUsuario" value="" />
    <add key="SmtpSenha" value="" />
    <add key="EmailRemetente" value="" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <!-- 5 MB (valor em KB) -->
    <httpRuntime maxRequestLength="5120" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <!-- 5 MB (valor em bytes) -->
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
